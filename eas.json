{
  "cli": {
    "version": ">= 12.0.0",
    "appVersionSource": "remote"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal",
      "android": {
        "buildType": "apk"
      },
      "ios": {
        "simulator": false
      }
    },
    "preview": {
      "distribution": "internal",
      "android": {
        "buildType": "apk"
      },
      "ios": {
        "simulator": false
      },
      "env": {
        "EXPO_PUBLIC_DEMO": "1"
      }
    },
    "testflight-demo": {
      "distribution": "store",
      "autoIncrement": true,
      "ios": {
        "simulator": false
      },
      "env": {
        "EXPO_PUBLIC_DEMO": "1"
      }
    },
    "production": {
      "autoIncrement": true
    }
  },
  "submit": {
    "production": {},
    "testflight-demo": {
      "ios": {
        "ascAppId": "6807728417",
        "appleTeamId": "J58R53HC5M",
        "ascApiKeyPath": "./PLACEHOLDER_AuthKey.p8",
        "ascApiKeyId": "PLACEHOLDER_ASC_API_KEY_ID",
        "ascApiKeyIssuerId": "PLACEHOLDER_ASC_API_KEY_ISSUER_ID"
      }
    }
  }
}
