{
  "cli": {
    "version": ">= 12.0.0",
    "appVersionSource": "remote"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal",
      "android": {
        "buildType": "apk"
      },
      "ios": {
        "simulator": false
      }
    },
    "preview": {
      "distribution": "internal",
      "android": {
        "buildType": "apk"
      },
      "ios": {
        "simulator": false
      },
      "env": {
        "EXPO_PUBLIC_DEMO": "1"
      }
    },
    "testflight-demo": {
      "distribution": "store",
      "autoIncrement": true,
      "ios": {
        "simulator": false
      },
      "env": {
        "EXPO_PUBLIC_DEMO": "1"
      }
    },
    "camera-demo": {
      "//": "DIRECT-INSTALL (ad-hoc) ONLY per docs/ops/camera-on-testflight-compliance.md §10/§12: the live-camera build must NEVER reach App Store Connect / TestFlight (internal TestFlight auto-distributes every build to every internal tester). distribution:internal has zero auto-distribute surface -- installs via QR/link to devices registered with `eas device:create`. Two named principals only; anyone else = full Tier-2 contract. There is deliberately NO submit block for this profile.",
      "distribution": "internal",
      "ios": {
        "simulator": false
      },
      "env": {
        "EXPO_PUBLIC_CAMERA_DEMO": "1"
      }
    },
    "production": {
      "autoIncrement": true
    }
  },
  "submit": {
    "production": {},
