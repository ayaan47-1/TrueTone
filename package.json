{
  "name": "truetone",
  "version": "1.0.0",
  "main": "expo-router/entry",
  "dependencies": {
    "@expo-google-fonts/fraunces": "^0.4.1",
    "@expo-google-fonts/mulish": "^0.4.2",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@supabase/supabase-js": "^2.108.2",
    "expo": "~56.0.12",
    "expo-blur": "~56.0.3",
    "expo-build-properties": "~56.0.19",
    "expo-constants": "~56.0.18",
    "expo-dev-client": "~56.0.20",
    "expo-file-system": "~56.0.8",
    "expo-font": "~56.0.7",
    "expo-linear-gradient": "~56.0.4",
    "expo-linking": "~56.0.14",
    "expo-localization": "~56.0.6",
    "expo-router": "~56.2.11",
    "expo-status-bar": "~56.0.4",
    "jpeg-js": "^0.4.4",
    "nativewind": "^4.2.5",
    "react": "19.2.3",
    "react-native": "0.85.3",
    "react-native-nitro-image": "^0.15.1",
    "react-native-nitro-modules": "^0.35.9",
    "react-native-reanimated": "4.3.1",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "4.25.2",
    "react-native-url-polyfill": "^3.0.0",
    "react-native-vision-camera": "^5.0.11",
    "react-native-vision-camera-face-detector": "^2.0.1",
    "react-native-vision-camera-worklets": "^5.1.1",
    "react-native-worklets": "0.8.3"
  },
  "devDependencies": {
    "@react-native/jest-preset": "^0.86.0",
    "@testing-library/jest-native": "^5.4.3",
    "@testing-library/react-native": "^14.0.0",
    "@types/jest": "^29.5.14",
    "@types/react": "~19.2.2",
    "babel-preset-expo": "^56.0.15",
    "jest": "^29.7.0",
    "jest-expo": "^56.0.5",
    "patch-package": "^8.0.1",
    "tailwindcss": "^3.4.17",
    "test-renderer": "^1.2.0",
    "typescript": "~6.0.3",
    "zod": "^4.4.3"
  },
  "scripts": {
    "postinstall": "patch-package",
    "start": "expo start",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "web": "expo start --web",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "test:integration": "node --test \"test/integration/**/*.test.mjs\"",
    "test:scripts": "node --test \"scripts/__tests__/**/*.test.mjs\" \"test/web/**/*.test.mjs\"",
    "waitlist:build": "node scripts/build-waitlist.mjs",
    "check:compliance": "node scripts/check-no-analytics-sdk.mjs && node scripts/check-waitlist-copy.mjs",
    "check:no-egress": "node scripts/check-no-image-egress.mjs",
    "eval:invariance": "jest eval/invariance/__tests__/report-writer.test.ts"
  },
  "private": true,
  "expo": {
    "doctor": {
      "reactNativeDirectoryCheck": {
        "exclude": [
          "react-native-vision-camera-face-detector",
          "expo-modules-jsi",
          "react-native-nitro-image"
        ]
      }
    }
  }
}
