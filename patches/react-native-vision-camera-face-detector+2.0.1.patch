+  // PATCHED (TrueTone, patches/react-native-vision-camera-face-detector+2.0.1.patch).
+  //
+  // Upstream takes `Any?` and tests `is String` / `is Map<*, *>`, which is the shape the old
+  // bridge delivered. Nitro does not deliver either: `InputImage` is the generated sealed class
+  // below, so EVERY call fell through to `else` and threw
+  //   "Invalid image type. Expected string or { uri }"
+  // regardless of what JS passed — a bare string arrives as InputImage.First and fails the same
+  // way. Verified against 2.0.6, which carries identical code, and against the iOS Swift file,
+  // which has the same flaw with `as? String` / `as? [String: Any]` against an enum.
   private fun resolveInputImage(
-    input: Any?
+    input: InputImage
   ): String {
     return when (input) {
-      is String -> input
-      is Map<*, *> -> {
-        val uri = input["uri"] as? String
-        uri ?: throw IllegalArgumentException("Invalid image object: missing 'uri'")
-      }
+      is InputImage.First -> input.value
+      is InputImage.Third -> input.value.uri
+      // Second is the `number` arm of `string | number | ImageUri` — a packager asset id, which
+      // this detector has no way to resolve to a file path.
       else -> throw IllegalArgumentException("Invalid image type. Expected string or { uri }")
     }
   }
