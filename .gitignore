# Visual brainstorm companion
.superpowers/

# Fairness eval: raw images + manifests with real faces NEVER enter git.
# The README documenting the rules IS committed; everything else under eval/data/ is ignored.
eval/data/*
!eval/data/README.md

# Expo prebuild (CNG) generated native projects
/android
/ios

# Imported design handoff bundle (scratch, not shipped)
skincare-routine-ai-app/
Skincare routine AI app-handoff.zip
truetone-design-system-bundle.txt

# truetone-brain is a SEPARATE repo (Obsidian vault). If cloned here for convenience,
# never let it get staged into the app repo.
truetone-brain/

# Waitlist site: everything below is generated by `npm run waitlist:build`.
# Policy pages are rendered from src/content/*.md (never edit them here, edit the source);
# config.js and _headers are written from the environment and config.js is deploy-specific.
#
# web/fonts/ is deliberately NOT ignored: the subsets are committed so a deploy needs
# neither pyftsubset nor node_modules. Re-run the build after changing a typeface.
web/policies/
web/config.js
web/_headers
